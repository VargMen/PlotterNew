<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
        Width="1280" Height="720"
        x:Class="PlotterNew.MainView"
        xmlns:controls="clr-namespace:PlotterNew.Controls"
        xmlns:vm="clr-namespace:PlotterNew.ViewModels"
        x:DataType="vm:MainViewModel"
        Title="PlotterNew">

        <Window.DataContext>
            <vm:MainViewModel></vm:MainViewModel>
         </Window.DataContext>
        
        <Grid ColumnDefinitions="65, *">
				<Border Grid.Column="0" Padding="12" Background="#1e1e1e" ZIndex="1">
                  <Canvas x:Name="SliderCanvas" Background="#222" />
                </Border>
            <Border Grid.Column="1" ZIndex="0">
                <controls:Canvas x:Name="MyCanvas"></controls:Canvas>
            </Border>
        </Grid>
</Window>
