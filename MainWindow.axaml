<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
        Width="1280" Height="720"
        x:Class="PlotterNew.MainWindow"
        Title="PlotterNew">


    <Grid Background="{DynamicResource PrimaryBackground}" ColumnDefinitions="200, *">
        <Border Padding="20" Background="{DynamicResource PrimaryBackgroundGradient}">
            <Grid RowDefinitions="*, Auto">
                <StackPanel Spacing="12">
                    <Image Source="/Assets/Images/rubicon_logo.png"></Image>
                    
                    <Button Content="Start plotting" HorizontalAlignment="Stretch"/>
                    <Button Content="Increase amplitude" HorizontalAlignment="Stretch"/>
                    <Button Content="Decrease amplitude" HorizontalAlignment="Stretch"/>
                    <Button Content="Decrease y-offset" HorizontalAlignment="Stretch"/>
                    <Button Content="Decrease y-offset" HorizontalAlignment="Stretch"/>
        
                </StackPanel>

                <TextBlock Grid.Row="1" Text="Status: Ready" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
