<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="PlotterNew.UI.Views.PlotView"
        xmlns:views="clr-namespace:PlotterNew.UI.Views"
        xmlns:vm="clr-namespace:PlotterNew.UI.ViewModels"
        x:DataType="vm:PlotViewModel">

    <Window.DataContext>
      <vm:PlotViewModel/>
    </Window.DataContext>

    <views:Canvas2D Model="{Binding Model}"/>

    <!-- <views:Canvas2D Model="{Binding Model}" RenderVersion="{Binding RenderVersion}"/>
    -->
</Window>
