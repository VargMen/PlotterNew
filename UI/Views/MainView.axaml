<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
        Width="1280" Height="720"
        x:Class="PlotterNew.MainView"
        xmlns:views="clr-namespace:PlotterNew.UI.Views"
        xmlns:vm="clr-namespace:PlotterNew.UI.ViewModels"
        x:DataType="vm:MainViewModel"
        Title="PlotterNew">
        
        <Window.DataContext>
            <vm:MainViewModel/>
        </Window.DataContext>
        
        <Grid ColumnDefinitions="300, *">
			<Grid Grid.Column="0" ColumnDefinitions="Auto, *"
              RowDefinitions="Auto, Auto, Auto"
              Margin="20" RowSpacing="8">

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Total samples amount:"
                           FontWeight="Bold"/>
                <TextBlock Grid.Row="0" Grid.Column="1"
                           Text="{Binding TotalSamplesAmount}"/>

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="Is data feed running:"
                           FontWeight="Bold"/>
                <TextBlock Grid.Row="1" Grid.Column="1"
                           Text="{Binding IsDataFeedRunning}"/>
            </Grid>
            <views:PlotView Grid.Column="1"/>
        </Grid>
    <!--
        <Grid>
            <views:PlotView DataContext="{Binding PlotVM}"/>
        </Grid>
            -->
</Window>
